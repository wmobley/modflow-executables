{
  "id": "modflow-2005-simulation",
  "version": "0.0.6801a19",
  "description": "Run an archive-first MODFLOW-2005 simulation on TACC.",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": ["SINGULARITY_RUN"],
  "containerImage": "docker://ghcr.io/wmobley/modflow-2005:sha-6801a19",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": false,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "ls6",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemOutputDir": "${JobWorkingDir}/output",
    "execSystemLogicalQueue": "vm-small",
    "archiveSystemId": "ls6",
    "archiveSystemDir": "HOST_EVAL($WORK)/tapis-jobs-archive/${JobCreateDate}/${JobName}-${JobUUID}",
    "archiveOnAppError": true,
    "isMpi": false,
    "mpiCmd": null,
    "cmdPrefix": "mkdir $PWD/work $PWD/home $PWD/scratch;",
    "parameterSet": {
      "appArgs": [],
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "description": "Scheduler profile for HPC clusters at TACC",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer",
          "notes": {"isHidden": true}
        },
        {
          "name": "TAP Session Substring",
          "description": "TAP Functions require the substring 'tap_' in the Slurm job name.",
          "inputMode": "FIXED",
          "arg": "--job-name ${JobName}-tap_",
          "notes": {"isHidden": true}
        },
        {
          "name": "TACC Allocation",
          "description": "TACC allocation charged for MODFLOW jobs.",
          "inputMode": "FIXED",
          "arg": "-A PT2050-DataX",
          "notes": {"isHidden": true}
        },
        {
          "name": "TACC Reservation",
          "description": "Reservation input string",
          "inputMode": "INCLUDE_ON_DEMAND",
          "arg": null,
          "notes": {"isHidden": true, "showReservation": true}
        }
      ],
      "envVariables": [],
      "archiveFilter": {"includes": [], "excludes": [], "includeLaunchFiles": true}
    },
    "fileInputs": [
      {
        "name": "mf2005-simulation-archive",
        "description": "Required ZIP archive containing a complete MODFLOW-2005 simulation.",
        "inputMode": "REQUIRED",
        "autoMountLocal": true,
        "sourceUrl": null,
        "targetPath": "simulation.zip"
      },
      {
        "name": "mf2005-wel",
        "description": "Optional MODFLOW-2005 WEL package replacement.",
        "inputMode": "OPTIONAL",
        "autoMountLocal": true,
        "sourceUrl": null,
        "targetPath": "provided/model.wel"
      },
      {
        "name": "mf2005-rch",
        "description": "Optional MODFLOW-2005 RCH package replacement.",
        "inputMode": "OPTIONAL",
        "autoMountLocal": true,
        "sourceUrl": null,
        "targetPath": "provided/model.rch"
      }
    ],
    "fileInputArrays": [],
    "nodeCount": 1,
    "coresPerNode": 1,
    "memoryMB": 1000,
    "maxMinutes": 60,
    "subscriptions": [],
    "tags": []
  },
  "tags": ["portalName: ALL"],
  "notes": {
    "label": "MODFLOW-2005",
    "helpUrl": "https://github.com/wmobley/modflow-executables",
    "helpText": "Provide one complete MODFLOW-2005 simulation ZIP. Optional WEL and RCH inputs replace the matching package records in the archive name file.",
    "hideNodeCountAndCoresPerNode": true,
    "isInteractive": false,
    "icon": "jupyter",
    "category": "Data Processing",
    "queueFilter": ["vm-small", "development", "normal"],
    "showReservation": true
  }
}
